# Copy this file to .env.local after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Optional trusted maintenance path only; normal authenticated pages do not use it.
# Never prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
