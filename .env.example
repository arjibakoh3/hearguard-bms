# BMS injects these when you select PostgreSQL during deployment.
# Use DATABASE_URL, or all DB_* fields below. Never use NEXT_PUBLIC_* for secrets.
DATABASE_URL=postgresql://app_owner:replace-password@postgres:5432/hearguard
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=hearguard
# DB_USER=app_owner
# DB_PASS=replace-password

# First startup of an empty database only. Choose your own real credentials.
HEARGUARD_ADMIN_EMAIL=admin@example.invalid
HEARGUARD_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Optional, server-only. Configure before printing signed reports.
# HEARGUARD_REPORT_SIGNER_NAME=
# HEARGUARD_REPORT_SIGNER_LICENSE=
# HEARGUARD_REPORT_SIGNATURE_BASE64=
