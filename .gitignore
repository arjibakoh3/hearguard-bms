# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/deliverables/*.app/

# Locally configured handwritten report signature (copied into desktop builds).
/private/report-assets/

# generated presentation build artifacts
/.hearguard-presentation-build/
/.hearguard-executive-slide-build/

# Generated reports and exports can contain patient data or report signatures.
/output/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Supabase local runtime
/supabase/.branches
/supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# BMS deployment repository: keep data and local assets out.
/deliverables/
/docs/
/native/
/supabase/
/tests/*
!/tests/database/
/private/
*.xlsx
*.xls
*.csv
*.pdf
*.pptx
